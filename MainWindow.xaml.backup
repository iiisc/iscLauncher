<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iscLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iscLauncher"
    xmlns:models="using:iscLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Realm Vault">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" 
              Grid.Row="0" 
              Height="44"
              Background="#0F0D0B"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <TextBlock Grid.Column="0"
                       Text="⚔"
                       FontSize="20"
                       Foreground="{StaticResource GoldBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <!-- App Title -->
            <TextBlock Grid.Column="1"
                       Text="Realm Vault"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- Drag Region -->
            <Border Grid.Column="2" Background="Transparent" />
        </Grid>

        <!-- Two-Column Layout: Game List + Detail Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Game List -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="16,8,16,8">
                    <ListView x:Name="GameListView"
                              SelectionMode="Single"
                              SelectionChanged="OnGameSelectionChanged"
                              DoubleTapped="OnGameDoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameEntry">
                            <Border Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Icon -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource GoldDarkBrush}"
                                            Opacity="0.2"
                                            CornerRadius="4"
                                            Width="48" Height="48"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <!-- Fallback icon -->
                                            <FontIcon x:Name="FallbackIcon"
                                                      Glyph="&#xE7FC;"
                                                      FontSize="20"
                                                      Foreground="{StaticResource GoldBrush}"
                                                      Opacity="0.6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            <!-- Actual game icon -->
                                            <Image x:Name="GameIcon"
                                                   Width="36" Height="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Loaded="OnGameIconLoaded" />
                                        </Grid>
                                    </Border>

                                    <!-- Game Info -->
                                    <StackPanel Grid.Column="1" 
                                                VerticalAlignment="Center" 
                                                Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" 
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ExecutablePath}"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1" />
                                        <!-- Server Info -->
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                                    Visibility="{x:Bind HasServerInfo}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" 
                                                        Visibility="{x:Bind HasRealmName}">
                                                <FontIcon Glyph="&#xE753;" FontSize="10" Foreground="{StaticResource EmeraldBrush}" />
                                                <TextBlock Text="{x:Bind RealmName}"
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource EmeraldLightBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        Visibility="{x:Bind HasAccountName}">
                                                <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                                <TextBlock Text="{x:Bind AccountName}"
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource GoldBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Click="OnEditClick" 
                                                Tag="{x:Bind}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTipService.ToolTip="Edit"
                                                Width="40"
                                                Height="40"
                                                Padding="0">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        </Button>
                                        <Button Click="OnDeleteClick" 
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Delete"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource CrimsonBrush}"
                                                BorderThickness="1"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="6"
                                                Padding="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource CrimsonBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Spacing="24">
            <!-- Icon -->
            <TextBlock Text="⚔" 
                       FontSize="64"
                       Foreground="{StaticResource GoldDarkBrush}"
                       Opacity="0.3"
                       HorizontalAlignment="Center"/>

            <!-- Message -->
            <TextBlock Text="No Games Configured"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="20"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Add your first game to begin your adventure"
                       FontFamily="{StaticResource SerifFont}"
                       FontStyle="Italic"
                       FontSize="12"
                       Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,-12,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" 
              Background="{StaticResource SurfaceBrush}"
              Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Panel -->
            <StackPanel x:Name="StatusPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon x:Name="StatusIcon" 
                          Glyph="&#xE73E;" 
                          FontSize="12"
                          Foreground="{StaticResource EmeraldBrush}" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Add Game Button -->
            <Button Grid.Column="1"
                    Click="OnAddGameClick"
                    Style="{StaticResource AddGameButtonStyle}"
                    Height="48"
                    Padding="24,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="+" FontSize="18" />
                    <TextBlock Text="Add Game" 
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
