<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="iscLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iscLauncher">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Backgrounds -->
      <Color x:Key="BgColor">#12100E</Color>
      <Color x:Key="TitleBarColor">#0F0D0B</Color>
      <Color x:Key="SurfaceColor">#1C1813</Color>
      <Color x:Key="Surface2Color">#221D17</Color>
      <Color x:Key="Surface3Color">#2B2419</Color>

      <!-- Accents -->
      <Color x:Key="GoldColor">#C9A84C</Color>
      <Color x:Key="GoldLightColor">#E8C97A</Color>
      <Color x:Key="GoldDarkColor">#8A6E2F</Color>
      <Color x:Key="EmeraldColor">#3D7A5C</Color>
      <Color x:Key="EmeraldLightColor">#5AAF85</Color>
      <Color x:Key="EmeraldDarkColor">#2D5A46</Color>
      <Color x:Key="EmeraldPressedColor">#1E4030</Color>
      <Color x:Key="EmeraldForegroundColor">#C8F0D8</Color>
      <Color x:Key="CrimsonColor">#9B3A3A</Color>

      <!-- Text -->
      <Color x:Key="TextPrimaryColor">#E8DCC8</Color>
      <Color x:Key="TextMutedColor">#8A7A65</Color>
      <Color x:Key="TextDimColor">#4A3F30</Color>

      <!-- Borders -->
      <Color x:Key="BorderColor">#2D2418</Color>
      <Color x:Key="BorderHighColor">#4A3820</Color>

      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
      <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
      <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
      <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
      <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}"/>
      <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}"/>
      <SolidColorBrush x:Key="EmeraldForegroundBrush" Color="{StaticResource EmeraldForegroundColor}"/>
      <SolidColorBrush x:Key="CrimsonBrush" Color="{StaticResource CrimsonColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
      <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderHighBrush" Color="{StaticResource BorderHighColor}"/>

      <!-- WinUI looks these up by name, so overriding them here restyles every control of that kind -->

      <!-- Buttons: gold by default -->
      <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource GoldColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource GoldLightColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource GoldDarkColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextDimColor}"/>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Surface3Color}"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Surface2Color}"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BorderHighColor}"/>

      <!-- Accent buttons (PrimaryButtonStyle and dialog primary buttons): emerald -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource EmeraldColor}"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource EmeraldDarkColor}"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource EmeraldPressedColor}"/>
      <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource EmeraldForegroundColor}"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#A0D0B0"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource EmeraldLightColor}"/>

      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource EmeraldColor}"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource EmeraldLightColor}"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource EmeraldDarkColor}"/>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White"/>

      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource EmeraldColor}"/>
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderHighColor}"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource EmeraldColor}"/>

      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Surface2Color}"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{StaticResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource GoldColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource GoldLightColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{StaticResource TextDimColor}"/>
      <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource Surface3Color}"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource Surface3Color}"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource Surface3Color}"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="Transparent"/>
      <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource EmeraldColor}"/>

      <!-- Buttons -->
      <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="{StaticResource EmeraldColor}" Offset="0"/>
              <GradientStop Color="{StaticResource EmeraldDarkColor}" Offset="1"/>
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <SolidColorBrush Color="{StaticResource EmeraldLightColor}" Opacity="0.3"/>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="6"/>
      </Style>

      <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHighBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <!-- The Add Game and Options buttons under the game list -->
      <Style x:Key="AddGameButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>

      <!-- Inputs -->
      <Style x:Key="InputBaseStyle" TargetType="Control">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <!-- Text and password boxes; a NumberBox uses InputBaseStyle, since this padding would land on its inner text box -->
      <Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource InputBaseStyle}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Height" Value="40"/>
      </Style>

      <!-- Panels -->
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,10"/>
      </Style>

      <!-- Text -->
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="CharacterSpacing" Value="150"/>
        <Setter Property="Foreground" Value="{StaticResource GoldDarkBrush}"/>
      </Style>

      <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <!-- Label above an input, or beside a value -->
      <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      </Style>

      <!-- Explanations and secondary details -->
      <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontStyle" Value="Italic"/>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
