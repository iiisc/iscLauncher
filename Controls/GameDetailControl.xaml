<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.GameDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot x:Name="DetailPivot" IsHeaderItemsCarouselEnabled="False" Margin="0,8,0,0" SelectionChanged="OnPivotSelectionChanged">
            <Pivot.Resources>
                <SolidColorBrush x:Key="PivotHeaderItemBackgroundSelected" Color="Transparent"/>
                <SolidColorBrush x:Key="PivotHeaderItemBackgroundPointerOver" Color="{StaticResource Surface3Color}"/>
                <SolidColorBrush x:Key="PivotHeaderItemForegroundSelected" Color="{StaticResource GoldColor}"/>
                <SolidColorBrush x:Key="PivotHeaderItemForegroundUnselected" Color="{StaticResource TextMutedColor}"/>
                <SolidColorBrush x:Key="PivotHeaderItemForegroundUnselectedPointerOver" Color="{StaticResource GoldLightColor}"/>
                <SolidColorBrush x:Key="PivotHeaderItemSelectedPipeFill" Color="{StaticResource GoldColor}"/>
            </Pivot.Resources>

            <PivotItem x:Name="GeneralTab" AutomationProperties.Name="General">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE10F;" FontSize="12"/>
                        <TextBlock Text="General" FontSize="12"/>
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer Padding="32,14,32,14">
                    <StackPanel Spacing="14">
                        <StackPanel x:Name="FoundInstallsSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="FOUND ON THIS PC" Style="{StaticResource SectionHeaderStyle}"/>
                            <StackPanel x:Name="FoundInstallsPanel" Orientation="Horizontal" Spacing="8"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="EXECUTABLE" Style="{StaticResource SectionHeaderStyle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExecutableTextBox" Style="{StaticResource InputStyle}" IsReadOnly="True"
                                         AutomationProperties.Name="Game executable"/>
                                <Button Grid.Column="1"
                                        Click="OnBrowseExecutableClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,0"
                                        ToolTipService.ToolTip="Browse for the game's exe"
                                        AutomationProperties.Name="Browse for the game's exe">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="11"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="OfficialNote"
                                   Text="Official Blizzard install. With a password saved under Automation, Launch starts the game and logs in to the account it remembers. Without one, Open in Battle.net takes you to it there, where you press Play."
                                   Style="{StaticResource HintTextStyle}"
                                   Visibility="Collapsed"/>

                        <TextBox x:Name="NameTextBox" Header="Game name" Style="{StaticResource InputStyle}"/>

                        <StackPanel x:Name="ConnectionSection" Spacing="8">
                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="RealmlistTextBox" Header="Realmlist address" Style="{StaticResource InputStyle}" PlaceholderText="e.g., logon.warmane.com"/>
                            <TextBox x:Name="AccountTextBox" Header="Account name" Style="{StaticResource InputStyle}" PlaceholderText="e.g., myaccount"/>
                            <TextBox x:Name="RealmTextBox" Header="Realm name" Style="{StaticResource InputStyle}" PlaceholderText="e.g., ChromieCraft"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="AutomationTab" AutomationProperties.Name="Automation">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D7;" FontSize="12"/>
                        <TextBlock Text="Automation" FontSize="12"/>
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer Padding="32,14,32,14">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <!-- WinUI's own reveal eye is drawn over the start of the password, so it's shown from the checkbox instead -->
                            <PasswordBox x:Name="PasswordBox" Header="Password" Style="{StaticResource InputStyle}" PasswordRevealMode="Hidden"/>
                            <CheckBox x:Name="ShowPasswordCheckBox" Content="Show password" FontSize="12"
                                      Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <NumberBox x:Name="StartupDelayNumberBox"
                                       Header="Startup delay (seconds)"
                                       Style="{StaticResource InputBaseStyle}"
                                       Width="180"
                                       HorizontalAlignment="Left"
                                       Minimum="0"
                                       Maximum="30"
                                       Value="0"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1"/>
                            <TextBlock Text="Wait before typing the password. Increase for slow-starting games."
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="SyncTab" AutomationProperties.Name="Sync">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="12"/>
                        <TextBlock Text="Sync" FontSize="12"/>
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer Padding="32,14,32,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SYNC BETWEEN PCS" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SyncRepoUrlTextBox" Style="{StaticResource InputStyle}" PlaceholderText="GitHub repo URL"
                                     AutomationProperties.Name="GitHub repo URL"/>
                            <Button x:Name="SetUpSyncButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="OnSetUpSyncClick"
                                    ToolTipService.ToolTip="Pick or create a private repo on your GitHub account for this game"
                                    AutomationProperties.Name="Set Up Sync">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="Set Up Sync"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- A grid, so a long status wraps instead of pushing the link out of sight -->
                        <Grid x:Name="SyncStatusPanel" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SyncStatusIcon" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SyncStatusText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <HyperlinkButton Grid.Column="2" Content="Open on GitHub" Click="OnOpenRepoClick" Padding="4,0" FontSize="12"
                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"
                                             ToolTipService.ToolTip="Open this game's sync repo in your browser"/>
                        </Grid>

                        <StackPanel x:Name="SyncButtonsPanel" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="SyncAddonsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnSyncAddonsClick" AutomationProperties.Name="Pull">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock Text="Pull"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UploadAddonsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnUploadAddonsClick" AutomationProperties.Name="Push">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" FontSize="14"/>
                                    <TextBlock Text="Push"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RollbackButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnRollbackClick" AutomationProperties.Name="Rollback">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                                    <TextBlock Text="Rollback"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <CheckBox x:Name="OfferPushCheckBox" Content="Offer to push when I close the game, if anything changed" FontSize="12"/>
                        <TextBlock x:Name="NoRepoHint"
                                   Text="Click Set Up Sync to sync this game's addons and settings between your PCs, or paste a repo URL and save."
                                   Style="{StaticResource HintTextStyle}"
                                   Visibility="Collapsed"/>

                        <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <ProgressRing x:Name="SyncProgressRing" IsActive="False" Width="24" Height="24"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelSyncClick" AutomationProperties.Name="Cancel sync">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="BackupsSection" Spacing="8" Margin="0,20,0,0">
                            <TextBlock Text="BACKUPS" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Addons and settings are backed up before every pull, copy, rollback and update. The last 3 are kept."
                                       Style="{StaticResource HintTextStyle}"/>
                            <Button x:Name="RestoreBackupButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnRestoreBackupClick"
                                    AutomationProperties.Name="Restore a Backup">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                                    <TextBlock Text="Restore a Backup"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="CopyAddonsSection" Spacing="8" Margin="0,20,0,0">
                            <TextBlock Text="SHARE ADDONS" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Copy addons and their settings into another game, or give your other characters the same addon setup as one character."
                                       Style="{StaticResource HintTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="CopyAddonsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyAddonsClick" AutomationProperties.Name="Copy Addons">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                        <TextBlock Text="Copy Addons"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CopyCharacterSetupButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyCharacterSetupClick" AutomationProperties.Name="Copy Character Setup">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                                        <TextBlock Text="Copy Character Setup"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="AddonsTab" AutomationProperties.Name="Addons">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="12"/>
                        <TextBlock Text="Addons" FontSize="12"/>
                    </StackPanel>
                </PivotItem.Header>
                <Border x:Name="AddonsHost" Padding="32,14,32,14"/>
            </PivotItem>
        </Pivot>

        <!-- Action bar; status messages sit beside the buttons so they never push the page around -->
        <Grid Grid.Row="1" Background="{StaticResource BgBrush}" Padding="32,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButtonStyle}" Height="56" Padding="40,0" Click="OnLaunchClick"
                        AutomationProperties.Name="{x:Bind LaunchButtonText.Text, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="LaunchButtonIcon" Text="⚔" FontSize="18"/>
                        <TextBlock x:Name="LaunchButtonText" Text="Launch"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="EditModeButtons" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Height="44" Padding="24,0" FontSize="13" Click="OnCancelEditClick"
                            AutomationProperties.Name="Cancel">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="56" Padding="40,0" Click="OnSaveClick"
                            AutomationProperties.Name="{x:Bind SaveButtonText.Text, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                            <TextBlock x:Name="SaveButtonText" Text="Save Changes"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <InfoBar x:Name="StatusBar"
                     Grid.Column="1"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Success"
                     VerticalAlignment="Center">
                <InfoBar.Content>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"/>
                </InfoBar.Content>
            </InfoBar>
        </Grid>
    </Grid>
</UserControl>
