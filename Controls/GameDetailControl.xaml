<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.GameDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: game name editor (edit mode only) -->
            <StackPanel Grid.Row="0" Spacing="8" Padding="32,18,32,0" MaxWidth="600" HorizontalAlignment="Left">
                <StackPanel x:Name="GameNameEditSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Game Name *" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             FontSize="13"/>
                </StackPanel>
                <Rectangle Height="1.5"
                           Fill="{StaticResource GoldDarkBrush}"
                           Opacity="0.3"
                           HorizontalAlignment="Left"
                           Width="90"/>
            </StackPanel>

            <!-- Status feedback -->
            <InfoBar x:Name="StatusBar"
                     Grid.Row="1"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Success"
                     Margin="32,8,32,0">
                <InfoBar.Content>
                    <TextBlock x:Name="StatusText"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"/>
                </InfoBar.Content>
            </InfoBar>

            <!-- Tabs -->
            <Pivot x:Name="DetailPivot"
                   Grid.Row="2"
                   IsHeaderItemsCarouselEnabled="False">
                <Pivot.Resources>
                    <SolidColorBrush x:Key="PivotHeaderItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="PivotHeaderItemBackgroundPointerOver" Color="{StaticResource Surface3Color}"/>
                    <SolidColorBrush x:Key="PivotHeaderItemForegroundSelected" Color="{StaticResource GoldColor}"/>
                    <SolidColorBrush x:Key="PivotHeaderItemForegroundUnselected" Color="{StaticResource TextMutedColor}"/>
                    <SolidColorBrush x:Key="PivotHeaderItemForegroundUnselectedPointerOver" Color="{StaticResource GoldLightColor}"/>
                    <SolidColorBrush x:Key="PivotHeaderItemSelectedPipeFill" Color="{StaticResource GoldColor}"/>
                </Pivot.Resources>

                <!-- General -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE10F;" FontSize="12"/>
                            <TextBlock Text="General" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer Padding="32,14,32,14">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="EXECUTABLE" Style="{StaticResource SectionHeaderStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExecutableTextBox"
                                             Style="{StaticResource ThemedTextBoxStyle}"
                                             FontSize="12"
                                             IsReadOnly="True" />
                                    <Button x:Name="BrowseButton"
                                            Grid.Column="1"
                                            Click="OnBrowseExecutableClick"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,0"
                                            Height="40"
                                            Visibility="Collapsed">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeaderStyle}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Realmlist Address" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RealmlistTextBox"
                                             Style="{StaticResource ThemedTextBoxStyle}"
                                             PlaceholderText="e.g., logon.warmane.com"
                                             FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Account Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AccountTextBox"
                                             Style="{StaticResource ThemedTextBoxStyle}"
                                             PlaceholderText="e.g., myaccount"
                                             FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Realm Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RealmTextBox"
                                             Style="{StaticResource ThemedTextBoxStyle}"
                                             PlaceholderText="e.g., ChromieCraft"
                                             FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- Automation -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D7;" FontSize="12"/>
                            <TextBlock Text="Automation" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer Padding="32,14,32,14">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PlaceholderText="Enter password to update"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Password Input Method" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="InputMethodComboBox"
                                          Style="{StaticResource ThemedComboBoxStyle}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="12">
                                    <ComboBoxItem Content="SendKeys (Best for DirectX)"/>
                                    <ComboBoxItem Content="Clipboard (Manual)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Window Title (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="WindowTitleTextBox"
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., 'Login' or 'World of Warcraft'"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Startup Delay (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="StartupDelayNumberBox"
                                           Style="{StaticResource ThemedNumberBoxStyle}"
                                           Minimum="0"
                                           Maximum="30"
                                           Value="0"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1" />
                                <TextBlock Text="Wait before typing the password. Increase for slow-starting games."
                                           Style="{StaticResource FieldHintStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- Addon Sync -->
                <PivotItem x:Name="AddonSyncTab">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="12"/>
                            <TextBlock Text="Addon Sync" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer Padding="32,14,32,14">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="GitHub Repo URL" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SyncRepoUrlTextBox"
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., https://github.com/user/wow-sync.git"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Branch" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SyncBranchTextBox"
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="main"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="THIS COMPUTER" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox x:Name="ComputerNameTextBox"
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         Height="32"
                                         Padding="8,4"
                                         FontSize="12"
                                         PlaceholderText="e.g., Gaming PC, Laptop..."
                                         LostFocus="OnComputerNameLostFocus"/>
                            </StackPanel>

                            <TextBlock x:Name="LastSyncedText"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontStyle="Italic"
                                       Visibility="Collapsed"/>

                            <HyperlinkButton x:Name="OpenRepoLink"
                                             Click="OnOpenRepoClick"
                                             Visibility="Collapsed"/>

                            <StackPanel x:Name="SyncButtonsPanel" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SyncAddonsButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="16,0"
                                        Click="OnSyncAddonsClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                        <TextBlock Text="Pull" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UploadAddonsButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="16,0"
                                        Click="OnUploadAddonsClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                                        <TextBlock Text="Push" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RollbackButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="16,0"
                                        Click="OnRollbackClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                                        <TextBlock Text="Rollback" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenRepoButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Width="40" Padding="0"
                                        Click="OnOpenRepoClick"
                                        ToolTipService.ToolTip="Open repo in browser">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                </Button>
                                <ProgressRing x:Name="SyncProgressRing"
                                              IsActive="False"
                                              Width="24" Height="24"
                                              Visibility="Collapsed"/>
                                <Button x:Name="CancelSyncButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="12,0"
                                        Click="OnCancelSyncClick"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                        <TextBlock Text="Cancel" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" Padding="32,16">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">

                <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="EditButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="44" Padding="24,0"
                            Click="OnEditClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                            <TextBlock Text="Edit Settings" FontFamily="{StaticResource DisplayFont}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LaunchButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="56" Padding="40,0"
                            Click="OnLaunchClick">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource EmeraldForegroundColor}"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A0D0B0"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource EmeraldDarkColor}"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource EmeraldPressedColor}"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource EmeraldLightColor}"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="LaunchButtonIcon" Text="⚔" FontSize="18" />
                            <TextBlock x:Name="LaunchButtonText" Text="Launch"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="15" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="EditModeButtons" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <Button x:Name="CancelEditButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="44" Padding="24,0"
                            Click="OnCancelEditClick">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Cancel" FontFamily="{StaticResource DisplayFont}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="56" Padding="40,0"
                            Click="OnSaveClick">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource EmeraldForegroundColor}"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A0D0B0"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource EmeraldDarkColor}"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource EmeraldPressedColor}"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource EmeraldLightColor}"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="{StaticResource EmeraldForegroundBrush}"/>
                            <TextBlock Text="Save Changes" FontFamily="{StaticResource DisplayFont}" FontSize="15" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
