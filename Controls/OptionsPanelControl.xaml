<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.OptionsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <ScrollViewer>
            <StackPanel Spacing="20" Padding="32,18,32,18">

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Success">
                    <InfoBar.Content>
                        <TextBlock x:Name="StatusText"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12"/>
                    </InfoBar.Content>
                </InfoBar>

                <!-- UPDATES -->
                <StackPanel Spacing="12">
                    <TextBlock Text="UPDATES" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Current version"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="VersionText"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        x:Name="CheckUpdatesButton"
                                        Click="OnCheckUpdatesClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="40"
                                        HorizontalAlignment="Right"
                                        Padding="14,0"
                                        VerticalAlignment="Center">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource EmeraldForegroundColor}"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A0D0B0"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource EmeraldDarkColor}"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource EmeraldPressedColor}"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource EmeraldLightColor}"/>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="CheckUpdatesIcon" Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock x:Name="CheckUpdatesText" Text="Check for Updates" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UpdateAvailableText"
                                       Visibility="Collapsed"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource EmeraldBrush}"
                                         Visibility="Collapsed"
                                         CornerRadius="4"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.4"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Check for updates on startup"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Silently checks for a new version when the app starts"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="CheckUpdatesOnStartupToggle"
                                              Grid.Column="1"
                                              IsOn="False"
                                              OnContent="" OffContent=""
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnCheckUpdatesOnStartupToggled"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DATA -->
                <StackPanel Spacing="12">
                    <TextBlock Text="DATA" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Game Library"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Backup or restore your game list"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnExportClick" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE898;" FontSize="12"/>
                                            <TextBlock Text="Export" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnImportClick" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                            <TextBlock Text="Import" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.4"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Data Folder"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Open the app data directory in Explorer"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnOpenDataFolderClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12"/>
                                        <TextBlock Text="Open" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.4"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Icon Cache"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Reload game icons from their executables"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnClearIconCacheClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="40" Padding="14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Clear Cache" FontFamily="{StaticResource DisplayFont}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SECURITY -->
                <StackPanel Spacing="12">
                    <TextBlock Text="SECURITY" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Stored Passwords"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="Remove all passwords from Windows Credential Manager"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="OnRemoveAllPasswordsClick"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CrimsonBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Height="40" Padding="14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource CrimsonBrush}"/>
                                    <TextBlock Text="Remove All"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource CrimsonBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
