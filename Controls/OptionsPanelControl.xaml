<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.OptionsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <ScrollViewer>
            <StackPanel Spacing="20" Padding="32,18,32,18">

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Success">
                    <InfoBar.Content>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"/>
                    </InfoBar.Content>
                </InfoBar>

                <StackPanel Spacing="12">
                    <TextBlock Text="UPDATES" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current version" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Button x:Name="CheckUpdatesButton"
                                        Grid.Column="2"
                                        Click="OnCheckUpdatesClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="40"
                                        Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="CheckUpdatesIcon" Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock x:Name="CheckUpdatesText" Text="Check for Updates"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UpdateAvailableText" Style="{StaticResource BodyTextStyle}" Visibility="Collapsed"/>
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource EmeraldBrush}"
                                         Visibility="Collapsed"
                                         CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="GITHUB" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="GitHubAccountText" Text="Not signed in" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="Lets the app sync addons between your PCs and create the sync repos for you."
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                            <Button x:Name="GitHubButton" Grid.Column="1" Click="OnGitHubClick" Style="{StaticResource SecondaryButtonStyle}">
                                <TextBlock x:Name="GitHubButtonText" Text="Sign In"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="DATA" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Data Folder" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="Open the app data directory in Explorer" Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnOpenDataFolderClick" Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="12"/>
                                    <TextBlock Text="Open"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
