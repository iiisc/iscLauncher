<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.GameListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iscLauncher.Models">

    <UserControl.Resources>
        <MenuFlyout x:Key="GameMenu" Opening="OnGameMenuOpening" MenuFlyoutPresenterStyle="{StaticResource MenuFlyoutPresenterStyle}">
            <MenuFlyoutItem Text="Remove from Library" Click="OnRemoveMenuClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16,8,16,8">
            <ListView x:Name="GameListView"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      DoubleTapped="OnDoubleTapped"
                      KeyDown="OnListKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                        <Setter Property="ContextFlyout" Value="{StaticResource GameMenu}"/>
                        <!-- The whole item is a card, so selecting it restyles the card instead of WinUI's default highlight -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Card"
                                            Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver"/>
                                                <VisualState x:Name="Pressed"/>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Card.Background" Value="{StaticResource Surface3Brush}"/>
                                                        <Setter Target="Card.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Target="Card.BorderThickness" Value="2"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Card.Background" Value="{StaticResource Surface3Brush}"/>
                                                        <Setter Target="Card.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Target="Card.BorderThickness" Value="2"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Card.Background" Value="{StaticResource Surface3Brush}"/>
                                                        <Setter Target="Card.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Target="Card.BorderThickness" Value="2"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameEntry">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        CornerRadius="4"
                                        Width="48" Height="48"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource GoldDarkColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <Grid>
                                        <FontIcon Glyph="&#xE72E;"
                                                  FontSize="20"
                                                  Foreground="{StaticResource GoldBrush}"
                                                  Opacity="0.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Width="40" Height="40"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Loaded="OnGameIconLoaded" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Border HorizontalAlignment="Left" CornerRadius="3" Padding="6,1"
                                            BorderBrush="{StaticResource BorderHighBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="{x:Bind ExecutablePath, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource GoldBrush}"
                                                   TextTrimming="CharacterEllipsis" Loaded="OnClientLabelLoaded" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                                Visibility="{x:Bind HasServerInfo, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind HasRealmName, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE753;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind RealmName, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind HasAccountName, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind AccountName, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0"
                                                Visibility="{x:Bind HasSyncRepo, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE895;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="Sync" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                                                    Visibility="{x:Bind HasRemoteChanges, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                            <TextBlock Text="New from another PC" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource GoldBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0"
                                                Visibility="{x:Bind HasAddonUpdates, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                        <TextBlock Text="Addon updates" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource GoldBrush}" />
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="AddGameButton"
                    AutomationProperties.Name="Add Game"
                    Click="OnAddGameClick"
                    Style="{StaticResource AddGameButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="Add Game" VerticalAlignment="Center" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>

            <Button Grid.Column="1"
                    x:Name="OptionsButton"
                    AutomationProperties.Name="Options"
                    Click="OnOptionsClick"
                    Style="{StaticResource AddGameButtonStyle}"
                    ToolTipService.ToolTip="Options">
                <Grid>
                    <FontIcon x:Name="OptionsButtonIcon" Glyph="&#xE713;" FontSize="16"/>
                    <Ellipse x:Name="UpdateDot"
                             Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-4,-6,0"
                             Visibility="Collapsed">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{StaticResource EmeraldLightColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
