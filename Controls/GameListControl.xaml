<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscLauncher.Controls.GameListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iscLauncher.Models"
    xmlns:converters="using:iscLauncher.Converters">

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16,8,16,8">
            <ListView x:Name="GameListView"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      DoubleTapped="OnDoubleTapped">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="Transparent"/>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameEntry">
                        <Border x:Name="GameCardBorder"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        CornerRadius="4"
                                        Width="48" Height="48"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource GoldDarkColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <Grid>
                                        <FontIcon x:Name="FallbackIcon"
                                                  Glyph="&#xE72E;"
                                                  FontSize="20"
                                                  Foreground="{StaticResource GoldBrush}"
                                                  Opacity="0.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image x:Name="GameIcon"
                                               Width="40" Height="40"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Loaded="OnGameIconLoaded" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ExecutableDisplayPath}"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                                Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasServerInfo)}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasRealmName)}">
                                            <FontIcon Glyph="&#xE753;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind RealmName}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasAccountName)}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind AccountName}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0"
                                                Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasSyncRepo)}">
                                        <FontIcon Glyph="&#xE895;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="Sync"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Click="OnDeleteClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Delete"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource CrimsonBrush}"
                                            BorderThickness="1"
                                            Width="40" Height="40"
                                            CornerRadius="6"
                                            Padding="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource CrimsonBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="AddGameButton"
                    Click="OnAddGameClick"
                    Style="{StaticResource AddGameButtonStyle}"
                    Height="56">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="Add Game"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>

            <Button Grid.Column="1"
                    x:Name="OptionsButton"
                    Click="OnOptionsClick"
                    Style="{StaticResource AddGameButtonStyle}"
                    Height="56"
                    Padding="0"
                    ToolTipService.ToolTip="Options">
                <FontIcon x:Name="OptionsButtonIcon" Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
