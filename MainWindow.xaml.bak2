<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iscLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iscLauncher"
    xmlns:models="using:iscLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Realm Vault">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" 
              Grid.Row="0" 
              Height="44"
              Background="#0F0D0B"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <TextBlock Grid.Column="0"
                       Text="⚔"
                       FontSize="20"
                       Foreground="{StaticResource GoldBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <!-- App Title -->
            <TextBlock Grid.Column="1"
                       Text="iscLauncher"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- Drag Region -->
            <Border Grid.Column="2" Background="Transparent" />
        </Grid>

        <!-- Two-Column Layout: Game List + Detail Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Game List -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="16,8,16,8">
                    <ListView x:Name="GameListView"
                              SelectionMode="Single"
                              SelectionChanged="OnGameSelectionChanged"
                              DoubleTapped="OnGameDoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GameEntry">
                                <Border x:Name="GameCardBorder"
                                        Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Indicator -->
                                        <Rectangle x:Name="SelectionIndicator"
                                                   Grid.Column="0"
                                                   Fill="{StaticResource GoldBrush}"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Visibility="Collapsed"
                                                   Margin="-12,0,0,0"/>

                                        <!-- Game Icon -->
                                        <Border Grid.Column="1"
                                                CornerRadius="4"
                                                Width="48" Height="48"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource GoldDarkColor}" Opacity="0.15"/>
                                            </Border.Background>
                                            <Grid>
                                                <!-- Fallback icon -->
                                                <FontIcon x:Name="FallbackIcon"
                                                          Glyph="&#xE7FC;"
                                                          FontSize="20"
                                                          Foreground="{StaticResource GoldBrush}"
                                                          Opacity="0.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <!-- Actual game icon -->
                                                <Image x:Name="GameIcon"
                                                       Width="40" Height="40"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Loaded="OnGameIconLoaded" />
                                            </Grid>
                                        </Border>

                                        <!-- Game Info -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center" 
                                                    Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" 
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ExecutablePath}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="1" />
                                            <!-- Server Info -->
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                                        Visibility="{x:Bind HasServerInfo}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" 
                                                            Visibility="{x:Bind HasRealmName}">
                                                    <FontIcon Glyph="&#xE753;" FontSize="10" Foreground="{StaticResource EmeraldBrush}" />
                                                    <TextBlock Text="{x:Bind RealmName}"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource EmeraldLightBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            Visibility="{x:Bind HasAccountName}">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                                    <TextBlock Text="{x:Bind AccountName}"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource GoldBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal" 
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Click="OnEditClick" 
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    ToolTipService.ToolTip="Edit"
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            </Button>
                                            <Button Click="OnDeleteClick" 
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource CrimsonBrush}"
                                                    BorderThickness="1"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="6"
                                                    Padding="0">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource CrimsonBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Add Game Button -->
                <Button Grid.Row="1"
                        Click="OnAddGameClick"
                        Style="{StaticResource AddGameButtonStyle}"
                        Height="56"
                        Margin="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="+" FontSize="18" />
                        <TextBlock Text="Add Game" 
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <!-- Right: Detail Panel -->
            <Grid Grid.Column="1" Background="{StaticResource BgBrush}">

                <!-- Unified View/Edit Mode -->
                <Grid x:Name="DetailPanel" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="32,20,32,16">
                        <StackPanel Spacing="16" MaxWidth="600">

                        <!-- Header -->
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="DetailGameName"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Rectangle Height="2" 
                                       Fill="{StaticResource GoldDarkBrush}"
                                       Opacity="0.3"
                                       HorizontalAlignment="Left"
                                       Width="120"/>
                        </StackPanel>

                        <!-- Connection Settings Section -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="⚔ CONNECTION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="10"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"
                                       Margin="0,8,0,0"/>

                            <StackPanel x:Name="RealmlistViewSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Realmlist" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="RealmlistViewValue" 
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="14"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="AccountViewSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Account" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="AccountViewValue" 
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="14"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="RealmViewSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Realm" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="RealmViewValue" 
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="14"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Automation Settings Section -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="⚙ AUTOMATION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="10"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"
                                       Margin="0,8,0,0"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Password Method" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="InputMethodViewValue" 
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="14"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="WindowTitleViewSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Window Title" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="WindowTitleViewValue" 
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="14"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Launch Settings Section -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="🗡 LAUNCH" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="10"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"
                                       Margin="0,8,0,0"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Executable" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ExecutableViewValue" 
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- View Mode Action Bar (Pinned at Bottom) -->
                    <Border Grid.Row="1"
                            x:Name="ViewActionBar"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="32,16">
                        <Grid MaxWidth="600" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Button x:Name="DetailEditButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="44"
                                        Padding="24,0"
                                        Click="OnDetailEditClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        <TextBlock Text="Edit Settings"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="DetailLaunchButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="56"
                                        Padding="40,0"
                                        Click="OnDetailLaunchClick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⚔" FontSize="18" />
                                        <TextBlock Text="Launch" 
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="15" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Status (aligned right) -->
                            <StackPanel Grid.Column="1"
                                        x:Name="ViewStatusPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <FontIcon x:Name="ViewStatusIcon" 
                                          Glyph="&#xE73E;" 
                                          FontSize="14"/>
                                <TextBlock x:Name="ViewStatusText"
                                           Text=""
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"/>
                                <Button Content="Copy"
                                        Click="OnCopyStatusClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Edit Mode -->
                <Grid x:Name="DetailEditScrollViewer" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="32,24,32,16">
                        <StackPanel Spacing="20" MaxWidth="600">

                        <!-- Header -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Edit Game Settings"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Rectangle Height="2" 
                                       Fill="{StaticResource GoldDarkBrush}"
                                       Opacity="0.3"
                                       HorizontalAlignment="Left"
                                       Width="120"/>
                        </StackPanel>

                        <!-- Game Name -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Game Name *"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox x:Name="EditGameNameTextBox" 
                                     Style="{StaticResource ThemedTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Executable Path -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Executable *"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditExecutableTextBox" 
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1" 
                                        Click="OnBrowseExecutableClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                        <TextBlock Text="Browse" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Connection Settings -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="⚔ CONNECTION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="10"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"
                                       Margin="0,12,0,0"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Realmlist Address"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditRealmlistTextBox" 
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., logon.warmane.com"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Account Name"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditAccountTextBox" 
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., myaccount"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Realm Name"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditRealmTextBox" 
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., ChromieCraft"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Automation Settings -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="⚙ AUTOMATION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="10"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"
                                       Margin="0,12,0,0"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Password"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <PasswordBox x:Name="EditPasswordBox" 
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PlaceholderText="Enter password to update"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Password Input Method"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="EditInputMethodComboBox" 
                                          Style="{StaticResource ThemedComboBoxStyle}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="SendKeys (Best for DirectX games)"/>
                                    <ComboBoxItem Content="UI Automation (Standard apps)"/>
                                    <ComboBoxItem Content="Clipboard (Manual paste)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Window Title (optional)"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditWindowTitleTextBox" 
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         PlaceholderText="e.g., 'Login' or 'World of Warcraft'"/>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Edit Mode Action Buttons (Pinned at Bottom) -->
                    <Border Grid.Row="1"
                            x:Name="EditActionBar"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="32,16">
                        <StackPanel Orientation="Horizontal" 
                                    Spacing="12"
                                    MaxWidth="600"
                                    HorizontalAlignment="Left">
                            <Button x:Name="CancelEditButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="44"
                                    Padding="24,0"
                                    Click="OnCancelEditClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                    <TextBlock Text="Cancel"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="SaveEditButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="56"
                                    Padding="40,0"
                                    Click="OnSaveEditClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="#C8F0D8"/>
                                    <TextBlock Text="Save Changes" 
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="15" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Height="48"
                                    Padding="36,0"
                                    Click="OnEditModeLaunchClick"
                                    Opacity="0.7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚔" FontSize="16" />
                                    <TextBlock Text="Launch" 
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty State (when no game selected) -->
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible"
                            Spacing="24">
                    <TextBlock Text="⚔" 
                               FontSize="64"
                               Foreground="{StaticResource GoldDarkBrush}"
                               Opacity="0.3"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Select a game to view details"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="18"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Or add your first game to begin"
                               FontFamily="{StaticResource SerifFont}"
                               FontStyle="Italic"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,-12,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
