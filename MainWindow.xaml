<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iscLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:iscLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="iscLauncher">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44"
              Background="{StaticResource TitleBarBrush}" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Grid.Column="0"
                   Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="iscLauncher" FontFamily="{StaticResource DisplayFont}"
                           FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontFamily="{StaticResource BodyFont}"
                           FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:GameListControl x:Name="GameList" Grid.Column="0"/>

            <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                <controls:GameDetailControl x:Name="GameDetail" Visibility="Collapsed"/>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Visible" Spacing="24">
                    <TextBlock Text="&#x2694;" FontSize="64" Foreground="{StaticResource GoldDarkBrush}"
                               Opacity="0.3" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a game to view details" FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Or add your first game to begin" FontFamily="{StaticResource SerifFont}"
                               FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,-12,0,0"/>
                </StackPanel>
                <controls:OptionsPanelControl x:Name="OptionsPanel" Visibility="Collapsed"/>
                <controls:AddGamePanelControl x:Name="AddGamePanel" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
