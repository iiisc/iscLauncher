<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iscLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iscLauncher"
    xmlns:models="using:iscLauncher.Models"
    xmlns:converters="using:iscLauncher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Realm Vault">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" 
              Grid.Row="0" 
              Height="44"
              Background="#0F0D0B"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <Image Grid.Column="0"
                   Source="/Assets/Square44x44Logo.scale-200.png"
                   Width="20"
                   Height="20"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />

            <!-- App Title -->
            <TextBlock Grid.Column="1"
                       Text="iscLauncher"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- Drag Region -->
            <Border Grid.Column="2" Background="Transparent" />
        </Grid>

        <!-- Two-Column Layout: Game List + Detail Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Game List -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="16,8,16,8">
                    <ListView x:Name="GameListView"
                              SelectionMode="Single"
                              SelectionChanged="OnGameSelectionChanged"
                              DoubleTapped="OnGameDoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GameEntry">
                                <Border x:Name="GameCardBorder"
                                        Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Game Icon -->
                                        <Border Grid.Column="0"
                                                CornerRadius="4"
                                                Width="48" Height="48"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource GoldDarkColor}" Opacity="0.15"/>
                                            </Border.Background>
                                            <Grid>
                                                <!-- Fallback icon -->
                                                <FontIcon x:Name="FallbackIcon"
                                                          Glyph="&#xE7FC;"
                                                          FontSize="20"
                                                          Foreground="{StaticResource GoldBrush}"
                                                          Opacity="0.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <!-- Actual game icon -->
                                                <Image x:Name="GameIcon"
                                                       Width="40" Height="40"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Loaded="OnGameIconLoaded" />
                                            </Grid>
                                        </Border>

                                        <!-- Game Info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center" 
                                                    Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" 
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ExecutablePath}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="1" />
                                            <!-- Server Info -->
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                                        Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasServerInfo)}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" 
                                                            Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasRealmName)}">
                                                    <FontIcon Glyph="&#xE753;" FontSize="10" Foreground="{StaticResource EmeraldBrush}" />
                                                    <TextBlock Text="{x:Bind RealmName}"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource EmeraldLightBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            Visibility="{x:Bind converters:BoolToVisibilityConverter.ToVisibility(HasAccountName)}">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                                    <TextBlock Text="{x:Bind AccountName}"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource GoldBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal" 
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Click="OnDeleteClick" 
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource CrimsonBrush}"
                                                    BorderThickness="1"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="6"
                                                    Padding="0">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource CrimsonBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Add Game Button -->
                <Button Grid.Row="1"
                        Click="OnAddGameClick"
                        Style="{StaticResource AddGameButtonStyle}"
                        Height="56"
                        Margin="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="Add Game" 
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <!-- Right: Detail Panel -->
            <Grid Grid.Column="1" Background="{StaticResource BgBrush}">

                <!-- Unified View/Edit Mode -->
                <Grid x:Name="DetailPanel" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="32,18,32,14">
                        <StackPanel Spacing="14" MaxWidth="600">

                        <!-- Header -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="DetailGameName"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Game Name Editor (shown only in edit mode) -->
                            <StackPanel x:Name="GameNameEditSection" Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="Game Name *"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditGameNameTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          FontSize="13"/>
                            </StackPanel>

                            <Rectangle Height="1.5" 
                                       Fill="{StaticResource GoldDarkBrush}"
                                       Opacity="0.3"
                                       HorizontalAlignment="Left"
                                       Width="90"/>
                        </StackPanel>

                        <!-- Status InfoBar -->
                        <InfoBar x:Name="StatusInfoBar"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Severity="Success"
                                 Margin="0,0,0,8">
                            <InfoBar.Content>
                                <TextBlock x:Name="StatusText"
                                           TextWrapping="Wrap"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"/>
                            </InfoBar.Content>
                        </InfoBar>

                        <!-- Executable Section -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="🗡 EXECUTABLE"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="9"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"/>
                            <Grid x:Name="ExecutableViewSection" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditExecutableTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          FontSize="12"
                                          IsReadOnly="True" />
                                <Button x:Name="BrowseButton"
                                         Grid.Column="1" 
                                         Click="OnBrowseExecutableClick"
                                         Style="{StaticResource SecondaryButtonStyle}"
                                         Padding="10,0"
                                         Height="40"
                                         Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Connection Settings -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚔ CONNECTION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="9"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Realmlist Address"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditRealmlistTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          PlaceholderText="e.g., logon.warmane.com"
                                          FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Account Name"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditAccountTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          PlaceholderText="e.g., myaccount"
                                          FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Realm Name"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditRealmTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          PlaceholderText="e.g., ChromieCraft"
                                          FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Automation Settings -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚙ AUTOMATION" 
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="9"
                                       CharacterSpacing="150"
                                       Foreground="{StaticResource GoldDarkBrush}"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Password"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <PasswordBox x:Name="EditPasswordBox" 
                                              Style="{StaticResource ThemedPasswordBoxStyle}"
                                              PlaceholderText="Enter password to update"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Password Input Method"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="EditInputMethodComboBox" 
                                           Style="{StaticResource ThemedComboBoxStyle}"
                                           HorizontalAlignment="Stretch"
                                           FontSize="12">
                                    <ComboBoxItem Content="SendKeys (Best for DirectX)"/>
                                    <ComboBoxItem Content="Clipboard (Manual)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Window Title (optional)"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="EditWindowTitleTextBox" 
                                          Style="{StaticResource ThemedTextBoxStyle}"
                                          PlaceholderText="e.g., 'Login' or 'World of Warcraft'"
                                          FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Startup Delay (seconds)"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <NumberBox x:Name="EditStartupDelayNumberBox"
                                           Minimum="0"
                                           Maximum="30"
                                           Value="0"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1" />
                                <TextBlock Text="Wait before typing the password. Increase for slow-starting games."
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- View Mode Action Bar (Pinned at Bottom) -->
                    <Border Grid.Row="1"
                            x:Name="ViewActionBar"
                            Background="{StaticResource BgBrush}"
                            Padding="32,16">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">
                            <!-- View Mode Buttons -->
                            <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal" Spacing="12">
                                <Button x:Name="DetailEditButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="44"
                                        Padding="24,0"
                                        Click="OnDetailEditClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        <TextBlock Text="Edit Settings"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="DetailLaunchButton"
                                         Style="{StaticResource PrimaryButtonStyle}"
                                         Height="56"
                                         Padding="40,0"
                                         Click="OnDetailLaunchClick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="LaunchButtonIcon" Text="⚔" FontSize="18" />
                                        <TextBlock x:Name="LaunchButtonText" Text="Launch" 
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="15" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Edit Mode Buttons -->
                            <StackPanel x:Name="EditModeButtons" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                                <Button x:Name="CancelEditButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="44"
                                        Padding="24,0"
                                        Click="OnCancelEditClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                        <TextBlock Text="Cancel"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SaveEditButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="56"
                                        Padding="40,0"
                                        Click="OnSaveEditClick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="#C8F0D8"/>
                                        <TextBlock Text="Save Changes" 
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="15" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty State (when no game selected) -->
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible"
                            Spacing="24">
                    <TextBlock Text="⚔" 
                               FontSize="64"
                               Foreground="{StaticResource GoldDarkBrush}"
                               Opacity="0.3"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Select a game to view details"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="18"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Or add your first game to begin"
                               FontFamily="{StaticResource SerifFont}"
                               FontStyle="Italic"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,-12,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
