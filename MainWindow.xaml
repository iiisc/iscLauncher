<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iscLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iscLauncher"
    xmlns:models="using:iscLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ISC Game Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" 
              Grid.Row="0" 
              Height="48"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <Image Grid.Column="0"
                   Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                   Width="24" Height="24"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />

            <!-- App Title -->
            <TextBlock Grid.Column="1"
                       Text="ISC Game Launcher"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold" />

            <!-- Drag Region (invisible, allows window dragging) -->
            <Border Grid.Column="2" Background="Transparent" />
        </Grid>

        <!-- Game List with cards -->
        <ListView x:Name="GameListView"
                  Grid.Row="1"
                  Padding="16,8,16,16"
                  SelectionMode="Single"
                  DoubleTapped="OnGameDoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameEntry">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Game Icon with fallback -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="6"
                                    Width="48" Height="48">
                                <Grid>
                                    <!-- Fallback icon (shown when image fails) -->
                                    <FontIcon x:Name="FallbackIcon"
                                              Glyph="&#xE7FC;"
                                              FontSize="24"
                                              Opacity="0.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    <!-- Actual game icon -->
                                    <Image x:Name="GameIcon"
                                           Width="36" Height="36"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Loaded="OnGameIconLoaded" />
                                </Grid>
                            </Border>

                            <!-- Game Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" 
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           FontSize="14" />
                                <TextBlock Text="{x:Bind ExecutablePath}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           Opacity="0.7"
                                           FontSize="11" />
                                <!-- Server Info (shown if configured) -->
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0"
                                            Visibility="{x:Bind HasServerInfo}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" 
                                                Visibility="{x:Bind HasRealmName}">
                                        <FontIcon Glyph="&#xE753;" FontSize="10" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind RealmName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Opacity="0.8"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Visibility="{x:Bind HasAccountName}">
                                        <FontIcon Glyph="&#xE77B;" FontSize="10" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind AccountName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Opacity="0.8"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" 
                                        Orientation="Horizontal" 
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Click="OnLaunchClick"
                                        Tag="{x:Bind}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        CornerRadius="6"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock Text="Launch" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnEditClick" 
                                        Tag="{x:Bind}" 
                                        ToolTipService.ToolTip="Edit"
                                        CornerRadius="6"
                                        Padding="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Click="OnDeleteClick" 
                                        Tag="{x:Bind}" 
                                        ToolTipService.ToolTip="Delete"
                                        CornerRadius="6"
                                        Padding="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Spacing="8">
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="50"
                    Padding="16"
                    HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                       Width="64" Height="64"
                       Opacity="0.7" />
            </Border>
            <TextBlock Text="No games added yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
            <TextBlock Text="Click the button below to add your first game"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Footer with status and actions -->
        <Grid Grid.Row="2" 
              Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Subtle Status Text -->
            <StackPanel x:Name="StatusPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon x:Name="StatusIcon" 
                          Glyph="&#xE73E;" 
                          FontSize="12"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280" />
                <Button x:Name="CopyStatusButton"
                        Click="OnCopyStatusClick"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Copy full message">
                    <FontIcon Glyph="&#xE8C8;" FontSize="10" Opacity="0.6" />
                </Button>
            </StackPanel>

            <!-- Add Game Button -->
            <Button Grid.Column="1"
                    Click="OnAddGameClick"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="8"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add Game" FontWeight="SemiBold" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
