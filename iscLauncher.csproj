<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>iscLauncher</RootNamespace>
    <!-- Releases pass the real version; 0.0.0 marks a local build -->
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Only x64 is released. Set here, a plain dotnet build or publish makes exactly what ships. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Leaves out the parts of .NET and the Windows projections the app never calls: 150 fewer files, half the size -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- The COM and P/Invoke source generators the Start menu shortcut uses write unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Ships as a plain exe, so debug runs the same way instead of as an MSIX package -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Still needed although the app isn't packaged: it builds iscLauncher.pri, which holds the compiled XAML -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- The test project lives inside this folder but builds on its own -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Just WinUI: the full Windows App SDK also ships its AI, ML and Widgets runtimes, about 50 MB the app doesn't use -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260204000" />
  </ItemGroup>

  <Target Name="LeaveOutUnusedFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- Unused by the app -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'createdump.exe' Or '%(Filename)%(Extension)' == 'RestartAgent.exe'" />
      <!-- WinUI's own text in 85 other languages, a folder each. The app is in English, and Windows falls back to en-us. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.mui' And !$([System.String]::Copy('%(RelativePath)').StartsWith('en-us'))" />
    </ItemGroup>
  </Target>
</Project>
