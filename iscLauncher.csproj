<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>iscLauncher</RootNamespace>
    <!-- Releases pass the real version; 0.0.0 marks a local build -->
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Only x64 is released. Set here, a plain dotnet build or publish makes exactly what ships. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Compiled to native code holding only the parts of .NET the app calls, so no .NET runtime files ship with it -->
    <PublishAot>true</PublishAot>
    <!-- The COM and P/Invoke source generators the Start menu shortcut uses write unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Ships as a plain exe, so debug runs the same way instead of as an MSIX package -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Still needed although the app isn't packaged: it builds iscLauncher.pri, which holds the compiled XAML -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- The test project lives inside this folder but builds on its own -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Just WinUI: the full Windows App SDK also ships its AI, ML and Widgets runtimes, about 50 MB the app doesn't use -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260204000" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows App SDK features the app never uses, which it ships anyway: notifications, background tasks, camera,
         deployment, the new pickers, OAuth, power info, restarting, the bootstrapper that only framework-dependent apps
         need, and WebView2 -->
    <UnusedPublishFiles>
      ;Microsoft.Windows.AppNotifications.winmd;Microsoft.Windows.AppNotifications.Builder.winmd;Microsoft.Windows.BadgeNotifications.winmd;
      ;Microsoft.Windows.PushNotifications.winmd;PushNotificationsLongRunningTask.ProxyStub.dll;
      ;Microsoft.Windows.ApplicationModel.Background.winmd;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.winmd;
      ;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll;Microsoft.Windows.Media.Capture.winmd;
      ;Microsoft.Windows.Management.Deployment.winmd;Microsoft.Windows.Security.AccessControl.winmd;Microsoft.Windows.Storage.winmd;
      ;Microsoft.Windows.Storage.Pickers.winmd;Microsoft.Security.Authentication.OAuth.winmd;Microsoft.Windows.System.winmd;
      ;Microsoft.Windows.System.Power.winmd;Microsoft.Windows.Globalization.winmd;Microsoft.Windows.ApplicationModel.DynamicDependency.winmd;
      ;RestartAgent.exe;Microsoft.WindowsAppRuntime.Bootstrap.dll;Microsoft.Web.WebView2.Core.dll;WebView2Loader.dll;
    </UnusedPublishFiles>
  </PropertyGroup>

  <Target Name="LeaveOutUnusedFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('$(UnusedPublishFiles)').Contains(';%(Filename)%(Extension);'))" />
      <!-- WinUI's own text in 85 other languages, a folder each. The app is in English, and Windows falls back to en-us. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.mui' And !$([System.String]::Copy('%(RelativePath)').StartsWith('en-us'))" />
    </ItemGroup>
  </Target>
</Project>
