<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="iscLauncher.Dialogs.GameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Game"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Background="{StaticResource Surface2Brush}"
    CornerRadius="8"
    MinWidth="900"
    MaxWidth="900">

    <ContentDialog.Resources>
        <!-- Override dialog button styles -->
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
        <!-- Override the internal max-width constraint of ContentDialog -->
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="860" Padding="4,0,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Add New Game"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="24"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Rectangle Height="1" 
                       Fill="{StaticResource GoldDarkBrush}"
                       Opacity="0.3"/>
        </StackPanel>

        <!-- Two-Column Layout -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Essentials -->
            <StackPanel Grid.Column="0" Spacing="16">
                <TextBlock Text="ESSENTIALS"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="9"
                           CharacterSpacing="150"
                           Foreground="{StaticResource GoldDarkBrush}"/>

                <!-- Game Name -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Game Name *"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="GameNameTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="Enter game name..." />
                </StackPanel>

                <!-- Executable Path -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Executable *"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecutablePathTextBox" 
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 IsReadOnly="True" 
                                 PlaceholderText="Select game executable..." />
                        <Button Grid.Column="1" 
                                Click="OnBrowseClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Password *"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <PasswordBox x:Name="GamePasswordBox" 
                                 Style="{StaticResource ThemedPasswordBoxStyle}"
                                 PlaceholderText="Enter game password" />
                </StackPanel>

                <!-- Input Method -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Password Input Method"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox x:Name="InputMethodComboBox" 
                              Style="{StaticResource ThemedComboBoxStyle}"
                              SelectedIndex="0" 
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="SendKeys (Best for DirectX games)"/>
                        <ComboBoxItem Content="Clipboard (Manual paste)"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Right Column: Connection & Advanced -->
            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="CONNECTION"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="9"
                           CharacterSpacing="150"
                           Foreground="{StaticResource GoldDarkBrush}"/>

                <!-- Realmlist Address -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Realmlist Address"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="RealmlistAddressTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="e.g., logon.warmane.com" />
                </StackPanel>

                <!-- Realm Name -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Realm Name"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="RealmNameTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="e.g., ChromieCraft" />
                </StackPanel>

                <!-- Account Name -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Account Name"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="AccountNameTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="e.g., myaccount" />
                    <TextBlock Text="Updates WTF\Config.wtf before launch" 
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextDimBrush}"
                               FontStyle="Italic"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Height="1" 
                           Fill="{StaticResource BorderBrush}"
                           Opacity="0.5"
                           Margin="0,4,0,0"/>

                <TextBlock Text="ADVANCED"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="9"
                           CharacterSpacing="150"
                           Foreground="{StaticResource GoldDarkBrush}"/>

                <!-- Window Title -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Window Title (optional)"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="WindowTitleTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="e.g., 'Login' or 'World of Warcraft'" />
                </StackPanel>

                <!-- Startup Delay -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Startup Delay (seconds)"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <NumberBox x:Name="StartupDelayNumberBox"
                               Minimum="0"
                               Maximum="30"
                               Value="0"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="1" />
                    <TextBlock Text="Wait before typing the password. Increase for slow-starting games (e.g., 3–5 for WoW)."
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextDimBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Height="1" 
                           Fill="{StaticResource BorderBrush}"
                           Opacity="0.5"
                           Margin="0,4,0,0"/>

                <TextBlock Text="ADDON SYNC"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="9"
                           CharacterSpacing="150"
                           Foreground="{StaticResource GoldDarkBrush}"/>

                <!-- Sync Repo URL -->
                <StackPanel Spacing="6">
                    <TextBlock Text="GitHub Repo URL"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="SyncRepoUrlTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="e.g., https://github.com/user/wow-sync.git" />
                </StackPanel>

                <!-- Sync Branch -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Branch"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="SyncBranchTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             PlaceholderText="main" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Error Display -->
        <InfoBar x:Name="ErrorInfoBar" 
                 Grid.Row="2"
                 Severity="Error" 
                 IsOpen="False" 
                 Background="{StaticResource CrimsonBrush}"
                 Opacity="0.15"
                 CornerRadius="6"
                 Margin="0,16,0,0" />
    </Grid>
</ContentDialog>
