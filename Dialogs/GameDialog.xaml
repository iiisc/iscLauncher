<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="iscLauncher.Dialogs.GameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Game"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Background="{StaticResource Surface2Brush}"
    CornerRadius="8">

    <ContentDialog.Resources>
        <!-- Override dialog button styles -->
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Spacing="16" MinWidth="480" Padding="4,0,16,0">

            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Add New Game"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="24"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <Rectangle Height="1" 
                           Fill="{StaticResource GoldDarkBrush}"
                           Opacity="0.3"/>
            </StackPanel>

            <!-- Game Name -->
            <StackPanel Spacing="6">
                <TextBlock Text="Game Name *"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox x:Name="GameNameTextBox" 
                         Style="{StaticResource ThemedTextBoxStyle}"
                         PlaceholderText="Enter game name..." />
            </StackPanel>

            <!-- Executable Path -->
            <StackPanel Spacing="6">
                <TextBlock Text="Executable *"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox" 
                             Style="{StaticResource ThemedTextBoxStyle}"
                             IsReadOnly="True" 
                             PlaceholderText="Select game executable..." />
                    <Button Grid.Column="1" 
                            Click="OnBrowseClick"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                            <TextBlock Text="Browse" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="6">
                <TextBlock Text="Password"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <PasswordBox x:Name="GamePasswordBox" 
                             Style="{StaticResource ThemedPasswordBoxStyle}"
                             PlaceholderText="Enter game password" />
            </StackPanel>

            <!-- Input Method -->
            <StackPanel Spacing="6">
                <TextBlock Text="Password Input Method"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <ComboBox x:Name="InputMethodComboBox" 
                          Style="{StaticResource ThemedComboBoxStyle}"
                          SelectedIndex="0" 
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="SendKeys (Best for DirectX games)"/>
                    <ComboBoxItem Content="UI Automation (Standard apps)"/>
                    <ComboBoxItem Content="Clipboard (Manual paste)"/>
                </ComboBox>
            </StackPanel>

            <!-- Advanced Options -->
            <Expander HorizontalAlignment="Stretch" 
                      HorizontalContentAlignment="Stretch"
                      Background="{StaticResource SurfaceBrush}"
                      CornerRadius="6">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙" FontSize="14" />
                        <TextBlock Text="Advanced Options" 
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="16" Padding="12,12,12,8">

                    <!-- Window Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Window Title (optional)"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="WindowTitleTextBox" 
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 PlaceholderText="e.g., 'Login' or 'World of Warcraft'" />
                    </StackPanel>

                    <!-- Startup Delay -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Startup Delay (seconds)"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <NumberBox x:Name="StartupDelayNumberBox"
                                   Minimum="0"
                                   Maximum="30"
                                   Value="0"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" />
                        <TextBlock Text="Wait this many seconds after launch before typing the password. Increase for slow-starting games (e.g., 3–5 for WoW)."
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Section Header: Connection Settings -->
                    <TextBlock Text="⚔ CONNECTION"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="9"
                               CharacterSpacing="150"
                               Foreground="{StaticResource GoldDarkBrush}"
                               Margin="0,8,0,0"/>

                    <!-- Realmlist Address -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Realmlist Address"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="RealmlistAddressTextBox" 
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 PlaceholderText="e.g., logon.warmane.com" />
                    </StackPanel>

                    <!-- Realm Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Realm Name"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="RealmNameTextBox" 
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 PlaceholderText="e.g., ChromieCraft" />
                    </StackPanel>

                    <!-- Account Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Account Name"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="AccountNameTextBox" 
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 PlaceholderText="e.g., myaccount" />
                        <TextBlock Text="Updates WTF\Config.wtf before launch" 
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Error Display -->
            <InfoBar x:Name="ErrorInfoBar" 
                     Severity="Error" 
                     IsOpen="False" 
                     Background="{StaticResource CrimsonBrush}"
                     Opacity="0.15"
                     CornerRadius="6" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
